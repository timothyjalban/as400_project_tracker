# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment/config
.env
.env.*

# Local secrets loaded by the start_*.bat scripts (never commit real values)
secrets.local.bat

# Flask/runtime
instance/
*.log

# Local databases and backups
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*backup*.db
backups/

# OS/editor
.DS_Store
Thumbs.db
.vscode/

# Frontend tooling (if added later)
node_modules/

# Snapshot harness: fixtures/snapshots exported from the live DB hold real
# customer names + pricing. Only the hand-written synthetic set is committed.
tests/fixtures/orders/*
!tests/fixtures/orders/syn-*.json
tests/snapshots/*
!tests/snapshots/syn-*

# Or-Pac scraper debug artifacts (screenshots/HTML may contain session data)
scripts/_orepac_debug/

# Flutter/Dart (customer_app/flutter_files)
customer_app/flutter_files/build/
customer_app/flutter_files/.dart_tool/
customer_app/flutter_files/.idea/
customer_app/flutter_files/.flutter-plugins-dependencies
customer_app/flutter_files/**/*.iml

# Uploaded quote/invoice/PO/SOA files - large, not for git (see core.ATTACHMENTS_DIR)
/attachments/
