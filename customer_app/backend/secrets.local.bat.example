@echo off
rem Copy this file to secrets.local.bat and fill in real values.
rem secrets.local.bat is gitignored and must never be committed.
rem Used by start_proxy.bat.

set "ORDER_TRACKER_INTAKE_API_KEY=your-intake-api-key-here"

rem Or-Pac Marketplace login for the "Submit for Quote" feature.
set "OREPAC_USERNAME=you@example.com"
set "OREPAC_PASSWORD=your-orepac-password"

rem SMTP account that emails the quote PDF to the customer.
rem Defaults assume Microsoft 365; change SMTP_HOST/SMTP_PORT otherwise.
set "SMTP_HOST=smtp.office365.com"
set "SMTP_PORT=587"
set "SMTP_USERNAME=you@example.com"
set "SMTP_PASSWORD=your-smtp-app-password"
set "SMTP_FROM=you@example.com"
